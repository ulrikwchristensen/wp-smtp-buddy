{
	"name": "smtp-buddy/wp-smtp-buddy",
	"description": "Send WordPress email through authenticated SMTP or a transactional email API.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.1"
	},
	"require-dev": {
		"phpunit/phpunit": "^10.5",
		"brain/monkey": "^2.6",
		"wp-coding-standards/wpcs": "^3.1",
		"dealerdirect/phpcodesniffer-composer-installer": "^1.0",
		"phpstan/phpstan": "^2.1",
		"szepeviktor/phpstan-wordpress": "^2.0"
	},
	"autoload-dev": {
		"psr-4": {
			"SmtpBuddy\\": "src/",
			"SmtpBuddy\\Tests\\": "tests/"
		}
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"platform": {
			"php": "8.1.0"
		}
	},
	"scripts": {
		"test": "phpunit",
		"lint": "phpcs",
		"analyse": "phpstan analyse --memory-limit=1G"
	}
}
